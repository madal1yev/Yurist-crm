# LawCRM maxfiy sozlamalari — bu faylni nusxalab .env qiling va real qiymatlarni yozing.
#   Copy-Item .env.example .env
# .env git'ga chiqmaydi (.gitignore). Tokenni chat, log yoki kodga YOZMANG.
#
# DIQQAT: bu token chatda oshkor bo'lgan. BotFather orqali /revoke qilib,
# yangi token oling va FAQAT shu faylga yozing.

# ─── Telegram (brauzer orqali, ixtiyoriy, faqat lokal sinov uchun) ───
# Token bo'sh bo'lsa, bildirishnomalar faqat sayt ichida ko'rinadi.
# Production'da VITE_* o'rniga server/telegram-proxy.mjs ishlating —
# VITE_ prefiksi shuni anglatadi: qiymat build'ga keyin brauzerga tushadi.
VITE_TELEGRAM_BOT_TOKEN=
# Botga /start yuborgan chat ID (Telegram ID, +998... emas)
VITE_TELEGRAM_ADMIN_CHAT_ID=
# To'g'ridan-to'g'ri yuborish — tokenni oshkor qiladi, 0 qoldiring.
VITE_TELEGRAM_DIRECT=0
# server/telegram-proxy.mjs ning manzili
VITE_TELEGRAM_PROXY_URL=http://127.0.0.1:8787/api/notify
# Faqat dev/proxy-mode da. Production'da frontend orqali yuborish tavsiya etilmaydi —
# o'rniga o'z API'ngiz orqali chaqiring.
VITE_TELEGRAM_PROXY_KEY=

# ─── server/telegram-proxy.mjs uchun (server muhitida, .env'ga YOZMAYDI) ───
# $env:BOT_TOKEN="..."; $env:ADMIN_CHAT_ID="..."
# $env:PROXY_SECRET="<node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">"
# $env:ALLOWED_ORIGIN="https://crm.your-domain.uz"
# $env:NODE_ENV="production"; node server/telegram-proxy.mjs
